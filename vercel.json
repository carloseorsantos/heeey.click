{
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "/api/v1?path=:path*"
    },
    {
      "source": "/lousa-online",
      "destination": "/lousa-online/index.html"
    },
    {
      "source": "/whiteboard-mcp",
      "destination": "/whiteboard-mcp/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}

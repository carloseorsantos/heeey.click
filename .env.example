VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Busca semântica (Jev via Vercel AI Gateway). Na Vercel o token OIDC é usado
# automaticamente; localmente rode `vercel env pull` ou defina uma chave:
# AI_GATEWAY_API_KEY=
# Exige retenção zero de dados no provedor (só planos Pro/Enterprise da Vercel):
# AI_GATEWAY_ZDR=true
